		"micromark-extension-gfm": "3.0.0",
		"open": "^11.0.4",
		"smol-toml": "1.9.1",
		"web-tree-sitter": "0.27.1"
	},
	"description": "Code comments a newcomer can read. Short, plain, even.",
	"bin": {
		"telegrapher": "dist/main.js"
	},
	"devDependencies": {
		"@types/mdast": "4.0.4",
		"@types/node": "^26.6.3",
		"typescript": "^7.0.2"
	},
