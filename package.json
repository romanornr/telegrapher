{
	"name": "telegrapher",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"test": "node --test",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"@inquirer/password": "^5.2.2",
		"@typesafe-ai/sdk": "0.6.0",
